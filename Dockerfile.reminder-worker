# MedBuddy LINE dose reminder worker (arq). Build context: repository root (same as main API Dockerfile).
# Render: Background Worker service with dockerfilePath ./Dockerfile.reminder-worker
# Local: docker compose --profile reminders up
FROM docker.io/library/python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY apps/backend/pyproject.toml apps/backend/README.md /app/
COPY apps/backend/src/medbuddy /app/src/medbuddy

RUN pip install --no-cache-dir ".[llm,supabase,tts,reminders]"

CMD ["arq", "medbuddy.reminders.worker.WorkerSettings"]
