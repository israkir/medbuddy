# Copy to apps/frontend/.env — loaded by Expo for EXPO_PUBLIC_* at bundle time.

# Mock UI data vs calling the real API (when wired)
EXPO_PUBLIC_USE_MOCK_DATA=true

# Backend base URL for future API calls (see constants/integration.ts)
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Standalone app user id (sent as X-App-User-Id; 4–128 chars [a-zA-Z0-9:_.-])
EXPO_PUBLIC_APP_USER_ID=expo-local-user

# When the API enforces MEDBUDDY_MOBILE_BEARER_TOKEN, set the same value here (public to the bundle).
# EXPO_PUBLIC_MOBILE_BEARER_TOKEN=
