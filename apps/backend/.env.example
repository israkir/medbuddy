# Copy to apps/backend/.env or .env at the repository root (or export for local runs)

# Logging (Render / production: set to DEBUG for more detail)
LOG_LEVEL=INFO

# --- Quick switch: mock vs real integrations (single source of truth) ---
# Option A — boolean (code default: false = real adapters; requires LINE token when not using mocks)
# Set true for local runs without LINE, or use make be-dev / be-dev-mock (forces mocks).
MOCK_EXTERNAL_SERVICES=true
#
# Option B — overrides Option A when set: mock | real (aliases: local, live, production, …)
# MEDBUDDY_INTEGRATION=mock
# MEDBUDDY_INTEGRATION=real

# Public base URL of this API (optional metadata / future features).
PUBLIC_BASE_URL=http://localhost:8000

# BCP 47 locale for user-facing strings (JSON under src/medbuddy/locales/)
MEDBUDDY_LOCALE=zh-TW

# Prior user/assistant turns sent to the medication tool orchestrator (complete_chat_with_tools).
# Default 12; set 0 to disable. Separate from CONVERSATION_HISTORY_TURNS (routing / stored window).
# MEDBUDDY_AGENT_ORCHESTRATOR_HISTORY_TURNS=12

# Append a gentle reminder to complete missing profile fields (name, age, gender, emergency contact,
# health notes) every N user messages when gaps remain. Default 12; set 0 to disable.
# MEDBUDDY_PROFILE_COMPLETION_NUDGE_EVERY_N_USER_TURNS=12

# Optional: comma-separated Intent values to log into ``health_issue_events`` (default policy if unset).
# Use a single token ``all_non_off_topic`` to log every intent except ``off_topic``. Vitals from LogVitalTool still use ``log_vital`` rows separately; classifier policy excludes ``log_vital`` by default to avoid duplicate signals.
# MEDBUDDY_HEALTH_ISSUE_LOG_INTENTS=emergency,general_question,report_side_effects
# MEDBUDDY_HEALTH_ISSUE_LOG_INTENTS=all_non_off_topic

# Cap on rows pulled into doctor-summary prompts from ``health_issue_events`` (default 60, max 200).
# MEDBUDDY_HEALTH_ISSUE_SUMMARY_EVENTS_LIMIT=60

LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# LINE assistant: text+m4a when user sends voice (default), always, or off. Needs HTTPS PUBLIC_BASE_URL,
# GOOGLE_SPEECH_PROJECT_ID + Text-to-Speech API, and ffmpeg on the server for real TTS.
# MEDBUDDY_LINE_VOICE_REPLIES=audio_inbound

# Standalone app (`GET/POST /v1/app/*` except public health/info). If unset and MOCK_EXTERNAL_SERVICES=true,
# Bearer is not required (local dev only). Set in production alongside MEDBUDDY_INTEGRATION=real.
MEDBUDDY_MOBILE_BEARER_TOKEN=

# --- LLM (skipped when MOCK_EXTERNAL_SERVICES=true — uses in-memory MockLLM) ---
# Code default when LLM_PROVIDER is unset: gemini. Example below uses OpenAI; switch to
# LLM_PROVIDER=gemini and set GEMINI_API_KEY for Google Gemini.
# Install: pip install 'medbuddy-api[llm]'
LLM_PROVIDER=openai
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
SUPABASE_URL=
# Publishable key (sb_publishable_...) or legacy anon JWT — not the service_role secret; see:
# https://supabase.com/docs/guides/api/api-keys
SUPABASE_PUBLISHABLE_KEY=

# Drug cache TTLs (hours). 0 = no ``expires_at`` (reference rows stay valid until manually cleared).
# MEDBUDDY_DRUG_REFERENCE_CACHE_TTL_HOURS=168
# MEDBUDDY_DRUG_PERSONALIZATION_CACHE_TTL_HOURS=72

# Google Cloud. On Render, set these in Environment (Secret where appropriate); see render.yaml.
GOOGLE_SPEECH_PROJECT_ID=
# GOOGLE_SPEECH_LOCATION=global
# STT (and default ADC): path to service-account JSON
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# --- LINE dose reminders (Supabase + arq/Redis; optional) ---
# Install: pip install 'medbuddy-api[reminders]' (included in Docker image as [.][reminders] extra).
# REDIS_URL=redis://127.0.0.1:6379
# Worker (separate process): arq medbuddy.reminders.worker.WorkerSettings
# MEDBUDDY_CRON_SECRET=
# MEDBUDDY_REMINDER_DEFAULT_LOCAL_TIME=09:00
# MEDBUDDY_REMINDER_HORIZON_DAYS=14

# Optional: comma-separated minutes between primary reminder and each follow-up nudge (empty = no nudges).
# MEDBUDDY_REMINDER_NUDGE_INTERVALS_MINUTES=15,30,60
# Per-user calendar zone is patients.timezone in Postgres (default Asia/Taipei), not an env var.
