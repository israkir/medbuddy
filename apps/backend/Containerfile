# Podman/Docker compatible — build context: this directory (`podman build -f Containerfile .` from apps/backend)
FROM docker.io/library/python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY pyproject.toml README.md /app/
COPY src/medbuddy /app/src/medbuddy

RUN pip install --no-cache-dir .

EXPOSE 8000

CMD ["uvicorn", "medbuddy.main:app", "--host", "0.0.0.0", "--port", "8000"]
